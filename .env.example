# Conta Azul OAuth (app da DriveData)
CONTAAZUL_CLIENT_ID=
CONTAAZUL_CLIENT_SECRET=
# Precisa ser exatamente a cadastrada no portal do desenvolvedor. O app de
# desenvolvimento usa https://contaazul.com. Quando for para producao, troque
# pela nossa e o code passa a ser capturado sozinho.
CONTAAZUL_REDIRECT_URI=https://contaazul.com
CONTAAZUL_LOGIN_URL=https://login.contaazul.com
CONTAAZUL_TOKEN_URL=https://api-v2.contaazul.com/oauth/token
CONTAAZUL_API_URL=https://api-v2.contaazul.com
CONTAAZUL_SCOPE=openid profile aws.cognito.signin.user.admin

# Assinatura do parametro state do OAuth
OAUTH_STATE_SECRET=

# Chave de criptografia dos tokens salvos no banco (32 bytes em base64)
TOKEN_ENCRYPTION_KEY=

# Banco
# Worker e scripts: modo sessao. O `#` da senha vai como %23.
DATABASE_URL=
# App web em serverless: pooler em modo transacao, porta 6543, usuario postgres.<ref>
DATABASE_URL_POOLED=

# IA (Groq). Sem a chave, a analise por IA fica desligada e o resto funciona igual.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
