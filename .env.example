# Conta Azul OAuth (app da DriveData)
CONTAAZUL_CLIENT_ID=
CONTAAZUL_CLIENT_SECRET=
# Enquanto a redirect_uri cadastrada no portal for a do Google, deixe assim e
# o script pede para voce colar a URL de retorno. Depois de cadastrar a nossa,
# troque por http://localhost:3000/api/oauth/contaazul/callback e o code e
# capturado sozinho.
CONTAAZUL_REDIRECT_URI=https://www.google.com/
CONTAAZUL_AUTH_URL=https://auth.contaazul.com
CONTAAZUL_API_URL=https://api-v2.contaazul.com
CONTAAZUL_SCOPE=openid profile aws.cognito.signin.user.admin

# Assinatura do parametro state do OAuth
OAUTH_STATE_SECRET=

# Chave de criptografia dos tokens salvos no banco (32 bytes em base64)
TOKEN_ENCRYPTION_KEY=

# Banco
# Worker e scripts: modo sessao. O `#` da senha vai como %23.
DATABASE_URL=
# App web em serverless: pooler em modo transacao, porta 6543, usuario postgres.<ref>
DATABASE_URL_POOLED=
